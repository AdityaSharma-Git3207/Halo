{
  "name": "halo",
  "productName": "Halo",
  "private": true,
  "version": "1.0.0",
  "description": "Premium desktop widget for Windows",
  "author": "Aditya Sharma",
  "main": "main.js",
  "type": "module",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",

    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",

    "dist": "npm run build && electron-builder"
  },

  "dependencies": {
    "electron-store": "^11.0.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },

  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },

  "build": {
    "appId": "com.halo.widget",
    "productName": "Halo",

    "directories": {
      "output": "release"
    },

    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "public/icon.ico",
      "package.json"
    ],

    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Halo"
    }
  }
}